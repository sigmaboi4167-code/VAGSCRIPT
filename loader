    local Status = Data.Status or "Online"
    local Callback = Data.Callback or function() end
    
    local Items = { }
    local function FromRGB(r, g, b) return Color3.fromRGB(r, g, b) end
    
    Items["Card"] = Instance.new("Frame")
    Items["Card"].Parent = self.Items["Content"].Instance
    Items["Card"].Size = UDim2.new(1, 0, 0, 140)
    Items["Card"].BackgroundColor3 = FromRGB(18, 18, 18)
    Items["Card"].BorderSizePixel = 0
    Items["Card"].ZIndex = 5
    
    local Corner = Instance.new("UICorner", Items["Card"])
