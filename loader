    Items["Banner"] = Instance.new("ImageLabel", Items["Card"])
    Items["Banner"].Size = UDim2.new(1, 0, 0, 75)
    Items["Banner"].Image = ImageUrl
    Items["Banner"].BackgroundTransparency = 1
    Items["Banner"].ScaleType = Enum.ScaleType.Crop
    Items["Banner"].ZIndex = 6
    
    local BannerCorner = Instance.new("UICorner", Items["Banner"])
    BannerCorner.CornerRadius = UDim.new(0, 5)

    Items["Title"] = Instance.new("TextLabel", Items["Card"])
    Items["Title"].Text = Name
    Items["Title"].Position = UDim2.new(0, 10, 0, 85)
    Items["Title"].Size = UDim2.new(1, -20, 0, 20)
    Items["Title"].TextColor3 = FromRGB(255, 255, 255)
    Items["Title"].TextXAlignment = Enum.TextXAlignment.Left
    Items["Title"].Font = Enum.Font.GothamBold
    Items["Title"].TextSize = 15
    Items["Title"].BackgroundTransparency = 1
    Items["Title"].ZIndex = 6

    Items["Status"] = Instance.new("TextLabel", Items["Card"])
    Items["Status"].Text = "Status: " .. Status
    Items["Status"].Position = UDim2.new(0, 10, 0, 105)
    Items["Status"].Size = UDim2.new(1, -20, 0, 15)
    Items["Status"].TextColor3 = Status == "Online" and FromRGB(0, 255, 0) or FromRGB(255, 50, 50)
    Items["Status"].TextXAlignment = Enum.TextXAlignment.Left
    Items["Status"].Font = Enum.Font.Gotham
    Items["Status"].TextSize = 12
    Items["Status"].BackgroundTransparency = 1
    Items["Status"].ZIndex = 6

    Items["Btn"] = Instance.new("TextButton", Items["Card"])
    Items["Btn"].Text = "LOAD"
    Items["Btn"].Position = UDim2.new(1, -70, 1, -35)
