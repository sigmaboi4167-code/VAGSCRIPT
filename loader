local function SafeDownload(path, url)
    local function download()
        local success, result = pcall(function() return game:HttpGet(url) end)
        if success and result and #result > 1000 and not result:sub(1, 10):find("<") then
            writefile(path, result)
            return true
        end
        return false
    end

    if isfile(path) then
        local content = readfile(path)
        if #content < 1000 or content:sub(1, 10):find("<") or content:sub(1, 10):find("{") then
            delfile(path)
            download()
        end
    else
        download()
    end
end

