                    -- Forced update to prevent game-side flickering
                    if p.Size.X ~= size or p.Transparency ~= trans or p.CanCollide ~= false then
                        p.Size = Vector3.new(size, size, size)
                        p.Transparency = trans
                        p.CanCollide = false
                    end
                end
            end
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then process(player.Character) end
        end
