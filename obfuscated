        else for _, l in ipairs(RadiusCircle) do l.Visible = false end end
    else for _, l in ipairs(RadiusCircle) do l.Visible = false end end

    if not playerEnabled and not farmEnabled and not npcEnabled then 
        StrikeHighlight.Adornee = nil
        return 
    end
    
    if not HRP then 
        StrikeHighlight.Adornee = nil
        return 
    end

    -- 2. Unified Strike Logic
    if tick() - lastAuraStrike < delay then return end
    
    local targetData = auraCache.players[1] or auraCache.npcs[1] or auraCache.farm[1]

    if targetData then
        local target, model, dist = targetData.part, targetData.model, targetData.dist
        if dist <= 50 then
            StrikeHighlight.Adornee = highlightEnabled and model or nil
            if CommunicateMelee then
                -- Model-specific debounce and health check
                if model and model.Parent and (model:GetAttribute("Health") or 1) > 0 then
                    local now = tick()
                    if not modelStrikeDebounce[model] or (now - modelStrikeDebounce[model]) > (delay * 0.9) then
                        modelStrikeDebounce[model] = now
                        
                        local tool = Char:FindFirstChildOfClass("Tool")
                        local context = tool or Char
                        context:SetAttribute("State_Swing_Client", true)
                        
                        local hitPos = HRP.Position + (target.Position - HRP.Position).Unit * math.min(dist, 10)
                        
                        -- Fire Strike
                        CommunicateMelee:FireServer("Hit", target, hitPos)
                        
                        -- Throttle Swing to avoid ping overflow
                        if now - lastSwingTick > 0.3 then
                            CommunicateMelee:FireServer("Swing")
                            lastSwingTick = now
                        end
                        
                        task.delay(0.05, function() if context and context.Parent then context:SetAttribute("State_Swing_Client", false) end end)
                        lastAuraStrike = now
                    end
                end
            end
        else StrikeHighlight.Adornee = nil end
    else StrikeHighlight.Adornee = nil end
end)

