            end
            
            -- Block Detection Signals (WalkSpeed/Gravity detection)
            if mLower == "connect" or mLower == "onserverevent" then
                if typeof(self) == "RBXScriptSignal" then
                    local sigName = tostring(self):lower()
                    if sigName:find("walkspeed") or sigName:find("jumppower") or sigName:find("gravity") then
                        return oldNamecall(self, function() end)
                    end
                end
            end

            -- Block Attribute Detection
            if mLower == "setattribute" and (args[1] == "WalkSpeed" or args[1] == "Gravity") then
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end))

