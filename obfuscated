                currentSky.SkyboxBk = skyId
                currentSky.SkyboxDn = skyId
                currentSky.SkyboxFt = skyId
                currentSky.SkyboxLf = skyId
                currentSky.SkyboxRt = skyId
                currentSky.SkyboxUp = skyId
            end
