task.spawn(function()
    local success, DebrisFolder = pcall(function()
        return workspace:WaitForChild("Spawned", 5)
            :WaitForChild("MouseIgnoreFolder", 5)
            :WaitForChild("Debris", 5)
            :WaitForChild("Bullets", 5)
    end)

    if not success or not DebrisFolder then
        warn("[VX] Bullet Tracers: Debris folder not found!")
        return
    end

    local function ApplyTracers(bullet)
        if not bullet or bullet.Name ~= "Arrow" then return end
        local T = getgenv().Toggles
        local O = getgenv().Options
        if not (T and T.BulletTracersEnabled and T.BulletTracersEnabled.Value == true) then return end
        
        if T.BulletTracersLocalOnly and T.BulletTracersLocalOnly.Value == true then
            local creator = bullet:FindFirstChild("Creator") or bullet:FindFirstChild("player") or bullet:FindFirstChild("Owner")
            if creator and creator:IsA("ObjectValue") and creator.Value ~= LocalPlayer then
                return
            end
        end
        
        task.wait()
        if not bullet.Parent then return end
        
        local trail = bullet:FindFirstChildWhichIsA("Trail")
        if not trail then
            trail = Instance.new("Trail")
            trail.Name = "VX_Tracer"
        end
        
        local att0 = bullet:FindFirstChild("Attachment0") or bullet:FindFirstChild("Attachment") or bullet:FindFirstChildWhichIsA("Attachment")
        local att1 = bullet:FindFirstChild("Attachment1")
        
        if not att0 then
            att0 = Instance.new("Attachment")
            att0.Name = "Attachment0"
            att0.Position = Vector3.new(0, 0, -bullet.Size.Z/2)
            att0.Parent = bullet
        end
        
        if not att1 then
            att1 = Instance.new("Attachment")
            att1.Name = "Attachment1"
            att1.Position = Vector3.new(0, 0, bullet.Size.Z/2)
            att1.Parent = bullet
        end
        
        trail.Attachment0 = att0
        trail.Attachment1 = att1
        
        trail.Color = ColorSequence.new(O.BulletTracerColor.Value or Color3.fromRGB(255, 80, 30))
        trail.WidthScale = NumberSequence.new(O.BulletTracerWidth.Value or 0.25)
        trail.Lifetime = O.BulletTracerLifetime.Value or 0.45
        trail.MinLength = 0.1
        trail.Brightness = 1.6
        trail.Texture = "rbxassetid://707177944"
        trail.TextureLength = 3
        trail.Enabled = true
        
        trail.Parent = bullet
    end

    DebrisFolder.ChildAdded:Connect(function(child)
        if child.Name == "Arrow" then
            task.spawn(ApplyTracers, child)
        end
    end)

    for _, v in ipairs(DebrisFolder:GetChildren()) do
        if v.Name == "Arrow" then
            task.spawn(ApplyTracers, v)
        end
    end
end)

