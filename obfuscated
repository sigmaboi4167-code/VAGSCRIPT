local function ApplyColorLockedFF(part)
    if not part:IsA("BasePart") then return end
    if part:FindFirstChild("VX_COLOR_LOCK") then return end
    if table.find(BodyParts, part.Name) or part.Parent:IsA("Accessory") or part.Parent:IsA("Hat") then return end

    local tag = Instance.new("BoolValue", part)
    tag.Name = "VX_COLOR_LOCK"

    local light = Instance.new("PointLight", part)
    light.Brightness = 12; light.Range = 15; light.Shadows = false

    RunService.RenderStepped:Connect(function()
        local T = getgenv().Toggles
        local O = getgenv().Options
        if not (T and T.WeaponChams and T.WeaponChams.Value) then 
            if part.Material ~= Enum.Material.Plastic then
                part.Material = Enum.Material.Plastic; part.Transparency = 0; light.Enabled = false
            end
            return 
        end
        if part and part.Parent then
            local mat = Enum.Material[O.WeaponChamsMat.Value] or Enum.Material.ForceField
            part.Material = mat
            part.Transparency = (mat == Enum.Material.ForceField) and -0.5 or 0
            
            local finalWeaponColor = T.ESPRainbow.Value and Color3.fromHSV(GlobalHue / 360, 1, 1) or O.WeaponChamsColor.Value
