local freecamVelocity = Vector3.new()
RunService.RenderStepped:Connect(function(dt)
    local T = getgenv().Toggles
    local O = getgenv().Options
    if not (T and T.FreecamEnabled and T.FreecamEnabled.Value) then 
        freecamVelocity = Vector3.new()
        return 
    end
    
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local speed = O.FreecamSpeed.Value * 100
    local targetMove = Vector3.new()
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then targetMove = targetMove + cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then targetMove = targetMove - cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then targetMove = targetMove - cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then targetMove = targetMove + cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then targetMove = targetMove + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then targetMove = targetMove - Vector3.new(0, 1, 0) end
    
    -- Handle Rotation
    local mouseDelta = UserInputService:GetMouseDelta()
    local rotationX = -mouseDelta.X * 0.1
    local rotationY = -mouseDelta.Y * 0.1
    
    freecamVelocity = freecamVelocity:Lerp(targetMove * speed, 0.1)
    cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0)
    cam.CFrame = cam.CFrame + (freecamVelocity * dt)
end)

