    local function applyWorldESP(v)
        if not v:IsA("Model") then return end
        local n = v.Name:lower()
        local typeMap = {
            cotton = "Cotton", berry = "Berry", barrel = "Barrel", 
            food = "Food", crate = "Crate", bush = "Bush", 
            metal = "Metal", rock = "Rock", stone = "Rock"
        }
        local dName, color = nil, Color3.new(1,1,1)
        for k, name in pairs(typeMap) do
            if n:find(k) then
                dName = name
                if k == "berry" then color = Color3.new(1,0,0)
                elseif k == "barrel" then color = Color3.fromRGB(150, 75, 0)
                elseif k == "food" then color = Color3.new(1,0.6,0)
                elseif k == "crate" then color = Color3.new(1,1,0)
                elseif k == "bush" then color = Color3.new(0,1,0)
                elseif k == "metal" then color = Color3.new(0,0.8,1)
                elseif k == "rock" or k == "stone" then color = Color3.new(0.5,0.5,0.5)
                end
                break
            end
        end
        
        if dName then
            task.spawn(function()
                local h = Instance.new("Highlight")
                h.Name = "WorldHighlight"
                h.FillColor = color
                h.OutlineColor = Color3.new(1,1,1)
                h.FillTransparency = 0.4
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = v

                local b = Instance.new("BillboardGui")
                b.Name = "WorldLabel"
                b.Size = UDim2.new(0, 200, 0, 50)
                b.Adornee = v
                b.AlwaysOnTop = true
                b.Parent = v
                local t = Instance.new("TextLabel", b)
                t.BackgroundTransparency = 1; t.Size = UDim2.new(1,0,1,0); t.TextSize = 14; t.Font = 3; t.TextColor3 = color; t.TextStrokeTransparency = 0

                while v.Parent do
                    local enabled = T.WorldESPEnabled.Value
                    local showH = T.WorldESPHighlights.Value
                    local showL = T.WorldESPLabels.Value
                    local filter = Options.WorldESPList.Value
                    local inFilter = filter[dName]
                    
                    h.Enabled = enabled and showH and inFilter
                    b.Enabled = enabled and showL and inFilter
                    
                    if b.Enabled then
                        local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and (LocalPlayer.Character.PrimaryPart.Position - v:GetPivot().Position).Magnitude) or 0)
                        t.Text = dName .. "\n[" .. dist .. "m]"
                    end
                    task.wait(0.5)
                end
            end)
        end
    end

